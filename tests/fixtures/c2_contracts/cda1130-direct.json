        "title": "Candidate File",
        "type": "string"
      },
      "space": {
        "anyOf": [
          {
            "$ref": "#/$defs/TaskSpace"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "candidate_file"
    ],
    "title": "TaskRewriteResult",
    "type": "object"
  },
  "files": {
    "analysis/task_response.json": "{\n  \"project_root\": \"<CASE>\",\n  \"source_paths\": [\n    \"reference.py\"\n  ],\n  \"candidate_id\": \"parent\",\n  \"candidate_path\": \"<CASE>\\\\parent.py\",\n  \"goal\": \"Minimize arbitrary J while preserving outputs\",\n  \"context\": {\n    \"cases\": [\n      {\n        \"shape\": [\n          2,\n          4\n        ],\n        \"dtype\": \"float32\"\n      }\n    ],\n    \"history\": [\n      {\n        \"params\": {\n          \"tile\": 2\n        },\n        \"score\": 4.0\n      }\n    ]\n  },\n  \"objective\": {\n    \"direction\": \"minimize\",\n    \"label\": \"J\",\n    \"unit\": \"ms\"\n  },\n  \"params\": {\n    \"values\": {\n      \"tile\": 2\n    }\n  },\n  \"space\": {\n    \"params\": [\n      {\n        \"name\": \"tile\",\n        \"kind\": \"int\",\n        \"choices\": [\n          1,\n          2,\n          4\n        ],\n        \"description\": \"\"\n      }\n    ],\n    \"constraints\": []\n  },\n  \"resource_metrics\": [],\n  \"resources\": {},\n  \"responses\": []\n}",
    "candidate/current.py": "PARAMS = {'tile': 2}\ndef run(x): return x * 2\n",
    "opencode.json": "{\n  \"$schema\": \"https://opencode.ai/config.json\",\n  \"permission\": {\n    \"edit\": \"allow\",\n    \"bash\": \"allow\",\n    \"webfetch\": \"deny\",\n    \"external_directory\": \"allow\"\n  }\n}",
