# Experiment output -- large, machine-specific, and contains plaintext API keys in
# sandbox opencode.json files (the sandbox_config_path mechanism copies the whole
# provider block including options.apiKey into every agent sandbox).
runs/
runs-*/
*.log

# Secrets. opencode provider configs carry API keys in plaintext.
.opencode/
opencode.json
opencode.jsonc
*.jsonc
kimi-provider.yaml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local scratch
.omo/
.codegraph/
uv.lock

# Local caches and scratch that must never be committed
.triton-cache-wsl/
.tmp_*
# A directory literally named "D:" (U+F03A fullwidth-colon substitute), created when a
# script wrote a Windows absolute path through a POSIX API. Junk, not content.
D/
.scratch/

# Venv package listings fetched for a box-to-box diff; regenerate with pip freeze rather than
# treating them as a lockfile (they are a snapshot of two specific machines on one day).
.venvdiff/

# scratch: fetched events.jsonl copies and one-off readers used during live runs
.tmp-arms/

# Fetched third-party papers and search-result dumps kept as local reading material for a
# literature question. Not ours to redistribute, and the PDFs are megabytes each; the
# conclusions drawn from them live in docs/ instead, with arXiv ids so they can be re-fetched.
external_files/lit_*/
.cache/
